* rc flow fixture
V1 in 0 PULSE(0 5 0 1n 1n 1m 2m)
R1 in out 1k
C1 out 0 1u
.tran 3m
.save V(in) V(out)
.meas tran v_max MAX V(out)
.meas tran gain_error MAX V(out)
.meas tran Offset_Error MIN V(out)
.meas tran temp_warning MAX V(in,out)
.meas tran t_half WHEN V(out)=v_max/2
.meas tran t_error WHEN V(out)=v_max/2
.meas tran t_warning WHEN V(out)=v_max/2
.meas tran vr_max MAX V(in,out)
.end
